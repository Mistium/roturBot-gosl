// Relationship System for roturbot-gosl
// Manages thoughts about specific users, persisted to ./store/relationships.json
// Uses username as the identifier (originChats doesn't have separate user IDs)

def _loadRelationships() object (
  string data = fs.ReadFile("./store/relationships.json")
  if data.len == 0 (
    return {}
  )
  any parsed = data.JsonParse()
  if typeof(parsed) != "object" (
    return {}
  )
  return parsed.assert(object)
)

def _saveRelationships(object data) (
  fs.WriteFile("./store/relationships.json", data.toStr())
)

def setThoughts(string username, string thoughts) object (
  object data = _loadRelationships()
  data[username] = {
    username: username,
    thoughts: thoughts,
    last_updated: timestamp
  }
  _saveRelationships(data)
  return { success: true, username: username, thoughts: thoughts }
)

def getThoughts(string username) object (
  object data = _loadRelationships()
  if data.contains(username) (
    return data[username].assert(object)
  )
  return null
)

def appendThoughts(string username, string additional_thoughts) object (
  object data = _loadRelationships()
  string existing_thoughts = ""
  if data.contains(username) (
    object existing = data[username].assert(object)
    existing_thoughts = (existing.thoughts ?? "").toStr()
  )
  string combined = existing_thoughts
  if combined.len > 0 (
    combined ++= "\n\n" ++ additional_thoughts
  ) else (
    combined = additional_thoughts
  )
  data[username] = {
    username: username,
    thoughts: combined,
    last_updated: timestamp
  }
  _saveRelationships(data)
  return { success: true, username: username, thoughts: combined }
)

def removeThoughts(string username) object (
  object data = _loadRelationships()
  if data.contains(username) (
    data.delete(username)
    _saveRelationships(data)
    return { success: true, username: username, message: "Thoughts removed" }
  )
  return { success: false, username: username, message: "No thoughts found for this user" }
)

def modifyRelationship(string action, string username, string thoughts) object (
  if action == "set" (
    return setThoughts(username, thoughts)
  )
  if action == "append" (
    return appendThoughts(username, thoughts)
  )
  if action == "remove" (
    return removeThoughts(username)
  )
  return { error: "Invalid action: " ++ action ++ ". Use set, append, or remove." }
)

def getFormattedThoughts(string username) string (
  any rel = getThoughts(username)
  if typeof(rel) != "object" (
    return ""
  )
  object relationship = rel.assert(object)
  string thoughts = (relationship.thoughts ?? "").toStr()
  if thoughts.len == 0 (
    return ""
  )
  return "My thoughts on this person are: " ++ thoughts
)
