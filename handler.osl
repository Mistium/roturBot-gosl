def messageHandler(*Connection c, string message) (
  any json_raw = message.JsonParse()
  if typeof(json_raw) != "object" (
    return
  )
  object json = json_raw.assert(object)
  if json.listener != null (
    recent_listened_messages[json.listener] = json
    recent_message_listeners.append(json.listener)
    if recent_message_listeners.len > 1000 (
      recent_message_listeners.shift()
    )
  )
  // log json.cmd
  switch json.cmd (
    case "handshake"
      object val = json.val
      log "Connected to " ++ (val.server.name ?? "unknown")
      c.Send({
        cmd: "auth",
        validator: generateValidator(config.token, val.validator_key)
      })
    case "auth_success"
      log "Authentication successful"
    case "auth_error"
      log "Authentication error: " ++ (json.val ?? "unknown").toStr()
    case "ready"
      log "Ready to receive messages, user: " ++ (json.user.username ?? "unknown")
      registerAllSlashCommands(c)
    case "user_connect"
      // log "User connected: " ++ (user.username ?? "unknown")
    case "user_disconnect"
      // log "User disconnected: " ++ (json.username ?? "unknown")
    case "message_new"
      message_new(c, json, config.token.toStr())
    case "slash_call"
      handleSlashCall(c, json)
    case "slash_register"
      // acknowledgement — handled via listener in registerAllSlashCommands
    case "slash_add"
      // broadcast when commands are registered — no action needed
    case "slash_remove"
      // broadcast when commands are removed — no action needed
    case "slash_response"
      // echo back from our own slash_response send — handled via listener
    case "message_delete"
      // log "Message deleted in " ++ (json.channel ?? "unknown") + ": " ++ (json.id ?? "unknown")
    case "message_edit"
      // log "Message edited in " ++ (json.channel ?? "unknown") + ": " ++ (json.id ?? "unknown")
    case "typing"
      // log json.user.toStr() ++ " is typing in " ++ (json.channel ?? "unknown")
    case "ping"
    case "message_react_add"
    case "message_react_remove"

    case "channels_get"

    case "error"
    default
      // log "Unknown command: " ++ (json.cmd ?? "unknown")
      // log json
  )
)

def getListenedMessage(string listener) object (
  if !recent_listened_messages.contains(listener) (
    return null
  )
  object data = recent_listened_messages[listener]
  recent_listened_messages.delete(listener)
  return rawToMsg(data)
)

def reactToMessage(*Connection c, string channel, string message_id, string emoji) (
  c.Send({
    cmd: "message_react_add",
    channel: channel,
    id: message_id,
    emoji: emoji
  })
)

def registerCommand(string name, any handler) (
  commands[name] = handler
)

// registerSlashCommand registers a slash command handler alongside its schema
// for servers that support the slash_register protocol.
// schema should match the slash command object format:
//   { name, description, options?, whitelistRoles?, blacklistRoles?, ephemeral? }
def registerSlashCommand(string name, any handler, object schema) (
  commands["/" ++ name] = handler
  slash_schemas[name] = schema
)

def registerAllSlashCommands(*Connection c) (
  array schema_keys = slash_schemas.getKeys()
  if schema_keys.len == 0 (
    return
  )

  array cmds = []
  for i schema_keys.len (
    cmds.append(slash_schemas[schema_keys[i].toStr()])
  )

  c.Send({
    cmd: "slash_register",
    commands: cmds
  })
)

def handleSlashCall(*Connection c, object json) (
  any val_raw = json.val
  if typeof(val_raw) != "object" (
    return
  )
  object val = val_raw.assert(object)

  string command_name = val.command.toStr()
  string handler_key = "/" ++ command_name

  if !commands.contains(handler_key) (
    log "slash_call: unknown command /" ++ command_name
    return
  )

  object msg = {
    user: json.invokerUsername ?? json.invoker,
    channel: json.channel,
    id: "",
    content: "",
    args: val.args ?? {},
    command: command_name,
    invoker: json.invoker
  }

  commands[handler_key](c, msg)
)

def sendResponse(*Connection c, object msg, string content) object (
  if msg.command != null (
    string react_key = msg.command.toStr() ++ ":" ++ msg.invoker.toStr()
    pending_reactions[react_key] = true
    c.Send({
      cmd: "slash_response",
      channel: msg.channel,
      response: content,
      command: msg.command,
      invoker: msg.invoker
    })
    return {}
  )
  object data = rawToMsg(msg)
  string listener = randomString(20)
  c.Send({
    cmd: "message_new",
    channel: data.channel,
    content: content,
    listener: listener
  })
  while !recent_message_listeners.contains(listener) (
    wait 0.1
  )
  object sent = getListenedMessage(listener)
  return sent
)

def sendMessage(*Connection c, string channel_id, string content) object (
  string listener = randomString(20)
  c.Send({
    cmd: "message_new",
    channel: channel_id,
    content: content,
    listener: listener
  })
  while !recent_message_listeners.contains(listener) (
    wait 0.1
  )
  object sent = getListenedMessage(listener)
  return sent
)

def sendReply(*Connection c, object msg, string content) object (
  object data = rawToMsg(msg)
  string listener = randomString(20)
  c.Send({
    cmd: "message_new",
    channel: data.channel,
    content: content,
    reply_to: data.id,
    listener: listener
  })
  while !recent_message_listeners.contains(listener) (
    wait 0.1
  )
  return getListenedMessage(listener)
)

def editMessage(*Connection c, object msg, string content) object (
  object data = rawToMsg(msg)
  log "editMessage: channel=" ++ data.channel.toStr() ++ " id=" ++ data.id.toStr()
  string listener = randomString(20)
  c.Send({
    cmd: "message_edit",
    channel: data.channel,
    id: data.id,
    content: content,
    listener: listener
  })
  while !recent_message_listeners.contains(listener) (
    wait 0.1
  )
  return getListenedMessage(listener)
)