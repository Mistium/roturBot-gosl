def sanitizeContent(string content) string (
  content = content.replace("@", "@ ")

  return content
)

def formatThinkingTime(number start_time) string (
  number elapsed = (timestamp - start_time) / 1000

  if elapsed < 60 (
    return floor(elapsed).toStr() ++ "s"
  )

  number minutes = floor(elapsed / 60)
  number seconds = floor(elapsed % 60)

  return minutes.toStr() ++ "m " ++ seconds.toStr() ++ "s"
)

def transferCredits(string from_user, string to_user, number amount, string note) object (
  string url = "https://api.rotur.dev/admin/transfer_credits?to=" ++ to_user ++ "&amount=" ++ amount.toStr() ++ "&from=" ++ from_user ++ "&note=" ++ encodeURIComponent(note)
  object resp = requests.Post(url, ADMIN_HEADERS)

  any body = resp.body.toStr().JsonParse()
  if typeof(body) != "object" (
    return { error: "Request failed" }
  )

  return body.assert(object)
)
