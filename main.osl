import "osl/ws"
import "osl/requests"
import "osl/fs"
import "osl/crypto"
import "osl/arrays"

string API_BASE = "https://api.rotur.dev"

array recent_message_listeners = []
object recent_listened_messages = {}
object connections = {}
array servers = ["wss://chats.mistium.com", "wss://dms.mistium.com"]
object commands = {}
object slash_schemas = {}
object channel_messages = {}
object user_personalities = {}

object token_cache = {}
object pending_reactions = {}
string connect_url = ""
any boot_raw = null
"*Connection" boot_conn = null

object config = openObjectFile("./config.json")
string ADMIN_TOKEN = config.admin_token ?? ""

object ADMIN_HEADERS = {
  "Authorization": ADMIN_TOKEN,
  "Content-Type": "application/json",
}

import "./ai/ai.osl"
import "./ai/vercel.osl"
import "./ai/personalities.osl"
import "./ai/tools.osl"

import "./utils.osl"
import "./validator.osl"
import "./handler.osl"
import "./rotur.osl"
import "./message_cache.osl"
import "./helpers.osl"
import "./memory.osl"
import "./emotional_state.osl"
import "./relationship.osl"

import "./commands/hello.osl"
import "./commands/roturacc.osl"

// account
import "./slashes/account/usage.osl"
import "./slashes/account/created.osl"
import "./slashes/account/allkeys.osl"
import "./slashes/account/changepass.osl"
import "./slashes/account/refresh_token.osl"
import "./slashes/account/standing.osl"

// economy
import "./slashes/economy/balance.osl"
import "./slashes/economy/transfer.osl"
import "./slashes/economy/subscribe.osl"
import "./slashes/economy/unsubscribe.osl"
import "./slashes/economy/gamble.osl"

// keys
import "./slashes/keys/keys get.osl"
import "./slashes/keys/keys set.osl"
import "./slashes/keys/keys del.osl"

// social
import "./slashes/social/follow.osl"
import "./slashes/social/unfollow.osl"
import "./slashes/social/following.osl"
import "./slashes/social/most_followed.osl"
import "./slashes/social/block.osl"
import "./slashes/social/unblock.osl"
import "./slashes/social/blocked.osl"

// friends
import "./slashes/friends/friends add.osl"
import "./slashes/friends/friends remove.osl"
import "./slashes/friends/friends list.osl"
import "./slashes/friends/requests list.osl"
import "./slashes/friends/requests accept.osl"
import "./slashes/friends/requests reject.osl"
import "./slashes/friends/requests accept all.osl"
import "./slashes/friends/requests reject all.osl"

// stats
import "./slashes/stats/totalusers.osl"
import "./slashes/stats/accorigins.osl"

// misc
import "./slashes/misc/personality.osl"
import "./slashes/misc/tod.osl"

// slash command registration
import "./slashes/register_account.osl"
import "./slashes/register_economy.osl"
import "./slashes/register_keys.osl"
import "./slashes/register_social.osl"
import "./slashes/register_friends.osl"
import "./slashes/register_stats.osl"
import "./slashes/register_misc.osl"

import "./handlers/message_new.osl"

mainloop:

  registerCommand("!hello", hello)
  registerCommand("!roturacc", roturacc)

  registerAccountCommands()
  registerEconomyCommands()
  registerKeysCommands()
  registerSocialCommands()
  registerFriendsCommands()
  registerStatsCommands()
  registerMiscCommands()

  for i servers.len (
    connect_url = servers[i].toStr()
    boot_raw = ws.Connect(connect_url)
    if boot_raw == null (
      continue
    )
    boot_conn = boot_raw.assert("*Connection")
    boot_conn.OnMessage(messageHandler)
    boot_conn.EnableReconnect()
    boot_conn.data.serverUrl = connect_url
    connections[connect_url] = boot_conn
  )

  while true (
    wait 60000
    checkDailyReset()
  )
