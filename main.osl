  { threshold: 3000, role: "Active 3000+" },
  { threshold: 1000, role: "Active 1000+" },
  { threshold: 500, role: "Active 500+" },
  { threshold: 100, role: "Active 100+" }
]

array ACTIVITY_ROLE_NAMES = ["Active 100+", "Active 500+", "Active 1000+", "Active 3000+"]

import "./ai/ai.osl"
import "./ai/vercel.osl"
