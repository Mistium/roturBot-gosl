// slash command registration
import "./slashes/register_account.osl"
import "./slashes/register_economy.osl"
import "./slashes/register_keys.osl"
import "./slashes/register_social.osl"
import "./slashes/register_friends.osl"
import "./slashes/register_stats.osl"
import "./slashes/register_misc.osl"
import "./slashes/register_counting.osl"

import "./handlers/message_new.osl"
import "./handlers/roles_list.osl"
import "./handlers/user_roles_get.osl"
import "./handlers/users_list.osl"

import "./personality_store.osl"

mainloop:

  initUserPersonalities()

  registerCommand("!hello", hello)
  registerCommand("!roturacc", roturacc)

  registerAccountCommands()
  registerEconomyCommands()
  registerKeysCommands()
  registerSocialCommands()
  registerFriendsCommands()
  registerStatsCommands()
  registerMiscCommands()
  registerCountingCommands()

  for i servers.len (
    connect_url = servers[i].toStr()
    boot_raw = ws.Connect(connect_url)
    if boot_raw == null (
      continue
    )
    boot_conn = boot_raw.assert("*Connection")
    boot_conn.OnMessage(messageHandler)
    boot_conn.EnableReconnect()
    boot_conn.Set("serverUrl", connect_url)
    connections[connect_url] = boot_conn
  )

while true (
  wait 3600000
  checkActivityRoleDrops()
)
