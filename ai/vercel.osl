def queryAI(array messages, string tier, bool use_tools, array tools) object (
  string api_key = (config["vercel-api"] ?? "").toStr()

  if api_key.len == 0 (
    return { error: "API key not configured" }
  )

  api_key = (config["nvidia-api"] ?? api_key).toStr()

  // Tier-based model selection matching Python version:
  // Free → gpt-oss-120b
  // Lite → moonshotai/kimi-k2-instruct-0905
  // Plus/Drive/Pro/Max → z-ai/glm4.7 with thinking enabled
  string model_to_use = "moonshotai/kimi-k2-instruct-0905"
  bool use_thinking = false

  if tier == "Free" (
    model_to_use = "openai/gpt-oss-120b"
  ) else if tier != "Lite" (
    model_to_use = "z-ai/glm4.7"
    use_thinking = true
  )

  object body = {
    model: model_to_use,
    messages: messages,
    temperature: 1,
    top_p: 1,
    max_tokens: 16384
  }

  if use_thinking (
    body.chat_template_kwargs = {
      enable_thinking: true,
      clear_thinking: false
    }
  )

  if use_tools and tools.len > 0 (
    body.tools = tools
    body.parallel_tool_calls = true
  )

  number max_retries = 10
  number retry_count = 0

  while retry_count < max_retries (
    object response = requests.Post("https://integrate.api.nvidia.com/v1/chat/completions", {
      "Content-Type": "application/json",
      "Authorization": "Bearer " ++ api_key,
      "body": body
    })

    if !response.success (
      if retry_count < max_retries - 1 (
        retry_count += 1
        wait 2
        continue
      )
      return { error: "API request failed" }
    )

    number status = response.status.toNum()

    if status == 429 or status == 500 or status == 502 or status == 503 or status == 504 (
      if retry_count < max_retries - 1 (
        retry_count += 1
        wait 2
        continue
      )
      return { error: "API request failed with status " ++ status.toStr() ++ " after " ++ retry_count.toStr() ++ " retries" }
    )

    if status != 200 (
      return { error: "API request failed with status " ++ status.toStr() }
    )

    any parsedRaw = response.body.toStr().JsonParse()

    if typeof(parsedRaw) != "object" (
      return { error: "Invalid response format" }
    )

    object parsed = parsedRaw.assert(object)

    if parsed.error != null (
      return { error: parsed.error.toStr() }
    )

    if !parsed.contains("choices") (
      return { error: "Invalid response format" }
    )

    return parsed
  )

  return { error: "Max retries exceeded" }
)
