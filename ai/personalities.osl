def loadPersonalities() object (
  return { "roturbot": getDefaultPersonality() }
)

def getSystemPrompt() string (
  string path = "./personalities/_system.md"
  string content = fs.ReadFile(path)
  if content.len > 0 (
    return content
  )
  return ""
)

def getPersonalityPrompt(string name) string (
  string file_path = "./personalities/" ++ name ++ ".md"
  string content = fs.ReadFile(file_path)

  string system = getSystemPrompt()

  if content.len > 0 (
    return system ++ "\n\n" ++ content
  )

  return system ++ "\n\n" ++ getDefaultPersonality()
)

def getDefaultPersonality() string (
  string default_path = "./personalities/roturbot.md"
  string content = fs.ReadFile(default_path)

  if content.len > 0 (
    return content
  )

  return "You are a helpful AI assistant. Be friendly, concise, and helpful."
)

def getUserPersonality(string user_id) string (
  return getUserPersonalityName(user_id)
)

def setUserPersonality(string user_id, string personality_name) object (
  if personality_name.len == 0 (
    return { error: "personality_name is required" }
  )
  
  object personalities = _loadUserPersonalities()
  personalities[user_id] = personality_name
  _saveUserPersonalities(personalities)
  
  user_personalities[user_id] = personality_name
  
  return { success: true, user_id: user_id, personality: personality_name }
)

def listPersonalities() array (
  return [
    "roturbot",
    "butler",
    "cardinal",
    "detective",
    "goth",
    "madscientist",
    "maid",
    "ragebaiter",
    "riley",
    "roommate",
    "tsundere"
  ]
)
