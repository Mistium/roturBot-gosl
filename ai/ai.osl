def handleAIQuery(*Connection c, object msg, string server_url) (
  object user_data = validateUser(msg.user.toStr())

  if user_data.error != null (
    sendReply(c, msg, user_data.error.toStr())
    return
  )

  string tier = user_data.tier ?? "Free"

  if tier == "Free" (
    sendReply(c, msg, "Only subscribers can use this feature. Subscribe at https://ko-fi.com/mistium or use /subscribe to get Lite.")
    return
  )

  string channel_id = msg.channel.toStr()

  // For DMs, send standalone message instead of reply
  bool is_dm = server_url == "wss://dms.mistium.com"
  object reply_msg = {}
  if is_dm (
    reply_msg = sendMessage(c, channel_id, "waiting for ai...")
  ) else (
    reply_msg = sendReply(c, msg, "waiting for ai...")
  )

  string personality_name = getUserPersonality(msg.user.toStr())
  string personality = getPersonalityPrompt(personality_name)

  string content = msg.content.toStr()
  if content.toLower().startsWith("@roturbot") (
    content = content.trim("@roturbot".len + 1, -1).strip()
  )

  array messages = buildAIMessages(user_data.user.assert(object), content, personality, channel_id, c, server_url)

  object response = queryAIWithTools(c, channel_id, messages, tier, 0, server_url)

  if response.error != null (
    editMessage(c, reply_msg, "Sorry, I encountered an error: " ++ response.error.toStr())
    return
  )

  processResponse(c, reply_msg, response, tier)
)

def validateUser(string discord_id) object (
  object user = getUserProfile(discord_id)

  if user.error != null (
    return { error: user.error.toStr() }
  )

  object full_user = getUserData(user.username ?? discord_id)

  if full_user.error != null (
    return { error: full_user.error.toStr() }
  )

  object subscription = (full_user["sys.subscription"] ?? {}).assert(object)
  string tier = (subscription["tier"] ?? "Free").toStr()

  return {
    user: full_user,
    tier: tier
  }
)

def fetchChannelHistory(*Connection c, string channel_id, number limit) string (
  string listener = randomString(20)
  c.Send({
    cmd: "messages_get",
    channel: channel_id,
    limit: limit,
    listener: listener
  })
  
  while !recent_listened_messages.contains(listener) (
    wait 0.1
  )
  
  object data = recent_listened_messages[listener].assert(object)
  recent_listened_messages.delete(listener)
  
  any messages_raw = data.messages
  if typeof(messages_raw) != "array" (
    return ""
  )
  
  array messages = messages_raw.assert(array)
  
  if messages.len == 0 (
    return ""
  )
  
  string history = ""
  
  for i messages.len (
    any msg_raw = messages[i]
    if msg_raw == null or typeof(msg_raw) != "object" (
      continue
    )
    
    object msg = msg_raw.assert(object)
    string username = (msg.user ?? "unknown").toStr()
    string content = (msg.content ?? "").toStr()
    
    any reply_to_raw = msg.reply_to
    string reply_suffix = ""
    if reply_to_raw != null and typeof(reply_to_raw) == "object" (
      object reply_to = reply_to_raw.assert(object)
      string reply_user = (reply_to.user ?? "unknown").toStr()
      
      if messages.len.toNum() > 1 (
        for j messages.len (
          if i == j (
            continue
          )
          any prev_raw = messages[j]
          if prev_raw == null or typeof(prev_raw) != "object" (
            continue
          )
          object prev = prev_raw.assert(object)
          if (prev.id ?? "").toStr() == (reply_to.id ?? "").toStr() (
            reply_suffix = " (in reply to " ++ reply_user ++ " saying \"" ++ (prev.content ?? "unknown").toStr() ++ "\")"
          )
        )
      )
    )
    
    history += username ++ " said \"" ++ content ++ "\"" ++ reply_suffix ++ "\n"
  )
  
  return history
)

def buildAIMessages(object user, string prompt, string personality, string channel_id, *Connection c, string server_url) array (
  array messages = []

  messages.append({
    role: "system",
    content: personality
  })

  string user_context = "You are talking to the rotur user named: " ++ (user.username ?? "someone")
  user_context ++= ". On discord they are " ++ (user.discord_id ?? "unknown")
  user_context ++= " with display name: " ++ (user.display_name ?? user.username ?? "unknown")
  user_context ++= ". You are chatting in " ++ channel_id ++ "."
  user_context ++= " Channel ID: " ++ channel_id ++ " - Use this channel_id for save_memory and search_memories tool calls."

  messages.append({
    role: "system",
    content: user_context
  })

  // Inject emotional state context
  string emotional_state = getFormattedEmotionalState(channel_id)
  if emotional_state.len > 0 (
    messages.append({
      role: "assistant",
      content: emotional_state
    })
  )

  // Inject relationship thoughts for this user
  string user_id = (user.discord_id ?? user.username ?? "").toStr()
  string relationship_thoughts = getFormattedThoughts(user_id)
  if relationship_thoughts.len > 0 (
    messages.append({
      role: "assistant",
      content: relationship_thoughts
    })
  )

  // Inject relevant memories
  string username = (user.username ?? "").toStr()
  array tags_filter = []
  if username.len > 0 (
    tags_filter.append("user:" ++ username)
  )
  array user_memories = searchMemories(server_url, "user:" ++ username, tags_filter, 1, 5)
  array general_memories = searchMemories(server_url, prompt, [], 7, 8)

  // Combine without duplicates
  array all_memories = []
  object seen_mem_ids = {}
  for i user_memories.len (
    any mem_raw = user_memories[i]
    if mem_raw == null or typeof(mem_raw) != "object" (
      continue
    )
    object mem = mem_raw.assert(object)
    string mid = (mem.id ?? "").toStr()
    if !seen_mem_ids.contains(mid) (
      seen_mem_ids[mid] = true
      all_memories.append(mem)
    )
  )
  for i general_memories.len (
    any mem_raw = general_memories[i]
    if mem_raw == null or typeof(mem_raw) != "object" (
      continue
    )
    object mem = mem_raw.assert(object)
    string mid = (mem.id ?? "").toStr()
    if !seen_mem_ids.contains(mid) (
      seen_mem_ids[mid] = true
      all_memories.append(mem)
    )
  )

  if all_memories.len > 0 (
    string memory_text = "RELEVANT MEMORIES:\n"
    for i all_memories.len (
      any mem_raw = all_memories[i]
      if mem_raw == null or typeof(mem_raw) != "object" (
        continue
      )
      object mem = mem_raw.assert(object)
      memory_text ++= "- " ++ mem.content.toStr() ++ "\n"
    )
    messages.append({
      role: "system",
      content: memory_text
    })
  )

  string history = fetchChannelHistory(c, channel_id, 30)
  if history.len > 0 (
    messages.append({
      role: "system",
      content: "RECENT CHANNEL CONTEXT (last 30 messages):\n\n" ++ history
    })
  )

  messages.append({
    role: "user",
    content: prompt
  })

  return messages
)

def queryAIWithTools(*Connection c, string channel_id, array messages, string tier, number depth, string server_url) object (
  array ai_tools = openArrayFile("./ai/tools.json")
  object response = queryAI(messages, tier, true, ai_tools)

  if response.error != null (
    return response
  )

  if !response.contains("choices") or response.choices == null or response.choices.len == 0 (
    return { error: "No choices in response" }
  )

  any choice_raw = response.choices[1]
  if choice_raw == null or typeof(choice_raw) != "object" (
    return { error: "Invalid choice format" }
  )

  object choice = choice_raw.assert(object)
  any message_raw = choice.message

  if message_raw == null or typeof(message_raw) != "object" (
    return { error: "Invalid message format" }
  )

  object message = message_raw.assert(object)
  string content = message.content ?? ""

  if message.tool_calls != null and message.tool_calls.len > 0 (
    any tool_calls_raw = message.tool_calls
    if typeof(tool_calls_raw) != "array" (
      return { error: "Invalid tool_calls format" }
    )
    array tool_calls = tool_calls_raw.assert(array)

    object assistant_msg = {
      role: "assistant",
      content: content,
      tool_calls: tool_calls
    }
    messages.append(assistant_msg)

    for i tool_calls.len (
      any tc_raw = tool_calls[i]
      if tc_raw == null or typeof(tc_raw) != "object" (
        continue
      )
      object tc = tc_raw.assert(object)
      string tc_id = tc.id ?? ""

      any func_raw = tc.function
      if func_raw == null or typeof(func_raw) != "object" (
        continue
      )
      object func_data = func_raw.assert(object)

      string func_name = func_data.name ?? ""
      string args_raw = func_data.arguments ?? "{}"

      any args_parsed = args_raw.JsonParse()
      object args = {}
      if typeof(args_parsed) == "object" (
        args = args_parsed.assert(object)
      )

      string tool_result = callTool(c, func_name, args, channel_id, server_url)

      if tool_result == "__SILENT_EXIT__" (
        return { choices: [{ message: { content: "" }, finish_reason: "silent_exit" }] }
      )

      object tool_msg = {
        role: "tool",
        tool_call_id: tc_id,
        content: tool_result
      }
      messages.append(tool_msg)
    )

    return queryAIWithTools(c, channel_id, messages, tier, depth + 1, server_url)
  )

  return response
)

def formatToolDisplay(string func_name, object args) string (
  string display = func_name

  if func_name == "search_web" and args.contains("query") (
    display = "researching web: \"" ++ args.query.toStr() ++ "\""
  ) else if func_name == "describe_image" and args.contains("image_url") (
    display = "describing image..."
  ) else if func_name == "get_user" and args.contains("username") (
    display = "getting user: " ++ args.username.toStr()
  ) else if func_name == "extract_page" and args.contains("urls") (
    array urls = args.urls.assert(array)
    string url_preview = urls[1].toStr() ?? ""
    display = "reading page: " ++ url_preview
  ) else if func_name == "get_current_time" (
    display = "getting current time..."
  ) else if func_name == "get_timezone_info" and args.contains("timezone") (
    display = "checking timezone: " ++ args.timezone.toStr()
  ) else if func_name == "search_lore" and args.contains("query") (
    display = "searching lore: \"" ++ args.query.toStr() ++ "\""
  ) else if func_name == "get_posts" and args.contains("username") (
    display = "getting posts for: " ++ args.username.toStr()
  ) else if func_name == "search_posts" and args.contains("query") (
    display = "searching posts: \"" ++ args.query.toStr() ++ "\""
  ) else if func_name == "convert_timestamp" (
    display = "converting timestamp..."
  ) else if func_name == "save_memory" (
    display = "saving memory..."
  ) else if func_name == "search_memories" and args.contains("query") (
    display = "searching memories: \"" ++ args.query.toStr() ++ "\""
  ) else if func_name == "update_memory" (
    display = "updating memory..."
  ) else if func_name == "modify_relationship" (
    display = "updating relationship thoughts..."
  ) else if func_name == "modify_emotional_state" and args.contains("action") (
    display = "updating emotional state (" ++ args.action.toStr() ++ ")..."
    ) else if func_name == "calculate" and args.contains("expression") (
      display = "calculating: " ++ args.expression.toStr()
    ) else if func_name == "search_messages" and args.contains("query") (
      display = "searching messages: \"" ++ args.query.toStr() ++ "\""
    ) else if func_name == "silent_exit" (
      display = "silent exit..."
    ) else if func_name == "make_web_request" and args.contains("url") (
      display = "requesting: " ++ args.url.toStr()
    )

  return "Calling " ++ display
)

def callTool(*Connection c, string name, object args, string channel_id, string server_url) string (
  switch name (
    case "describe_image"
      string image_url = (args.image_url ?? "").toStr()
      object result = describeImage(image_url)
      return result.toStr()

    case "get_user"
      string username = (args.username ?? "").toStr()
      object user = getUserProfile(username)
      return user.toStr()

    case "get_current_time"
      number ts = timestamp
      object result = {
        utc: {
          iso: "see unix timestamp below",
          unix: ts
        }
      }
      return result.toStr()

    case "get_timezone_info"
      string tz = (args.timezone ?? "UTC").toStr()
      object resp = requests.Get("https://apps.mistium.com/timezone-info?timezone=" ++ tz)
      if resp.success == true and resp.status == 200 (
        return resp.body.toStr()
      )
      return { error: "Failed to get timezone info" }.toStr()

    case "convert_timestamp"
      number ts = (args.timestamp ?? 0).toNum()
      return { timestamp: ts, readable: ts.toStr() ++ "ms since epoch" }.toStr()

    case "search_web"
      string query = (args.query ?? "").toStr()
      string tavily_key = (config["tavily-api"] ?? "").toStr()
      if tavily_key.len == 0 (
        return { error: "Tavily API key not configured" }.toStr()
      )
      object resp = requests.Post("https://api.tavily.com/search", {
        "Authorization": "Bearer " ++ tavily_key,
        "Content-Type": "application/json",
        "body": { query: query }
      })
      if resp.success (
        return resp.body.toStr()
      )
      return { error: "Search failed" }.toStr()

    case "search_lore"
      string query = (args.query ?? "").toStr()
      string tavily_key = (config["tavily-api"] ?? "").toStr()
      if tavily_key.len == 0 (
        return { error: "Tavily API key not configured" }.toStr()
      )
      object resp = requests.Post("https://api.tavily.com/search", {
        "Authorization": "Bearer " ++ tavily_key,
        "Content-Type": "application/json",
        "body": { query: "originos.fandom.com " ++ query }
      })

      if resp.success (
        any rawresults = resp.body.toStr().JsonParse().results
        if typeof(rawresults) != "array" (
          return { error: "Invalid response format" }.toStr()
        )
        array results = rawresults.assert(array)
        array out = []
        for i results.len (
          object result = results[i].assert(object)
          string url = result.url.toStr()
          if url.startsWith("https://originos.fandom.com") (
            out.append(url)
          )
        )
        return out.toStr()
      )
      return { error: "Search failed" }.toStr()

    case "extract_page"
      array urls = (args.urls ?? []).assert(array)
      string tavily_key = (config["tavily-api"] ?? "").toStr()
      if tavily_key.len == 0 (
        return { error: "Tavily API key not configured" }.toStr()
      )
      object resp = requests.Post("https://api.tavily.com/extract", {
        "Authorization": "Bearer " ++ tavily_key,
        "Content-Type": "application/json",
        "body": { urls: urls }
      })
      if resp.success (
        return resp.body.toStr()
      )
      return { error: "Extract failed" }.toStr()

    case "get_posts"
      string posts_user = (args.username ?? "").toStr()
      object posts_result = getPostsByUser(posts_user)
      return posts_result.toStr()

    case "search_posts"
      string posts_query = (args.query ?? "").toStr()
      object search_result = searchPostsByQuery(posts_query)
      return search_result.toStr()

    case "make_web_request"
      string method = (args.method ?? "").toStr()
      string url = (args.url ?? "").toStr()
      object headers = (args.headers ?? {}).assert(object)
      string body = (args.body ?? "").toStr()
      string params = (args.params ?? "").toStr()

      object resp = requests.Request(method, url, {
        "headers": headers,
        "body": body,
        "params": params
      })

      // log resp

      return resp.toStr()

    case "save_memory"
      string mem_content = (args.content ?? "").toStr()
      any tags_raw = args.tags
      array mem_tags = []
      if typeof(tags_raw) == "array" (
        mem_tags = tags_raw.assert(array)
      )
      number mem_importance = (args.importance ?? 5).toNum()
      number mem_ttl = (args.ttl_days ?? 30).toNum()
      object save_result = saveMemory(server_url, mem_content, mem_tags, mem_importance, mem_ttl)
      return save_result.toStr()

    case "search_memories"
      string search_query = (args.query ?? "").toStr()
      any stf_raw = args.tags_filter
      array search_tags = []
      if typeof(stf_raw) == "array" (
        search_tags = stf_raw.assert(array)
      )
      number search_min_imp = (args.min_importance ?? 1).toNum()
      number search_limit = (args.limit ?? 5).toNum()
      array search_results = searchMemories(server_url, search_query, search_tags, search_min_imp, search_limit)
      return search_results.toStr()

    case "update_memory"
      string update_id = (args.memory_id ?? "").toStr()
      string update_action = (args.action ?? "").toStr()
      number update_ttl = (args.new_ttl_days ?? 30).toNum()
      number update_boost = (args.importance_boost ?? 1).toNum()
      object update_result = updateMemory(server_url, update_id, update_action, update_ttl, update_boost)
      return update_result.toStr()

    case "modify_relationship"
      string rel_action = (args.action ?? "").toStr()
      string rel_user_id = (args.user_id ?? "").toStr()
      string rel_username = (args.username ?? "").toStr()
      string rel_thoughts = (args.thoughts ?? "").toStr()
      object rel_result = modifyRelationship(rel_action, rel_user_id, rel_username, rel_thoughts)
      return rel_result.toStr()

    case "modify_emotional_state"
      string es_action = (args.action ?? "").toStr()
      string es_state = (args.state ?? "").toStr()
      string es_reason = (args.reason ?? "").toStr()
      object es_result = modifyEmotionalState(es_action, channel_id, es_state, es_reason)
      return es_result.toStr()

    case "calculate"
      string expr = (args.expression ?? "").toStr()
      if expr.len == 0 (
        return { error: "expression is required" }.toStr()
      )
      // OSL does not have a math evaluator; return a note for the AI to compute
      return { note: "OSL does not support dynamic math evaluation. Expression: " ++ expr ++ " - please compute this yourself." }.toStr()

    case "search_messages"
      string search_query = (args.query ?? "").toStr()
      if search_query.len == 0 (
        return { error: "query is required" }.toStr()
      )
      
      string search_listener = randomString(20)
      c.Send({
        cmd: "messages_search",
        channel: channel_id,
        query: search_query,
        listener: search_listener
      })
      
      while !recent_listened_messages.contains(search_listener) (
        wait 0.1
      )
      
      object search_data = recent_listened_messages[search_listener].assert(object)
      recent_listened_messages.delete(search_listener)
      
      any results_raw = search_data.results
      if typeof(results_raw) != "array" (
        return { error: "Invalid search results format" }.toStr()
      )
      
      array results = results_raw.assert(array)
      
      if results.len == 0 (
        return { results: [], message: "No messages found matching query: " ++ search_query }.toStr()
      )
      
      string formatted = "Found " ++ results.len.toStr() ++ " message(s) matching \"" ++ search_query ++ "\":\n"
      for i results.len (
        any msg_raw = results[i]
        if msg_raw == null or typeof(msg_raw) != "object" (
          continue
        )
        object msg = msg_raw.assert(object)
        string username = (msg.user ?? "unknown").toStr()
        string content = (msg.content ?? "").toStr()
        number ts = (msg.timestamp ?? 0).toNum()
        formatted += "- " ++ username ++ " said \"" ++ content ++ "\" (timestamp: " ++ ts.toStr() ++ ")\n"
      )
      
      return { results: results, formatted: formatted }.toStr()

    case "silent_exit"
      return "__SILENT_EXIT__"
  )

  return { error: "Unknown tool: " ++ name }.toStr()
)

def processResponse(*Connection c, object reply_msg, object response, string tier) (
  if !response.contains("choices") or response.choices == null or response.choices.len == 0 (
    return
  )

  any first_choice_raw = response.choices[1]
  if first_choice_raw == null or typeof(first_choice_raw) != "object" (
    return
  )

  object first_choice = first_choice_raw.assert(object)
  string finish_reason = (first_choice.finish_reason ?? "").toStr()

  if finish_reason == "silent_exit" (
    return
  )

  any message_raw = first_choice.message
  if message_raw == null or typeof(message_raw) != "object" (
    return
  )

  object message_obj = message_raw.assert(object)
  string content = message_obj.content ?? ""

  if content.len == 0 (
    editMessage(c, reply_msg, "Sorry, I couldn't generate a response to that.")
    return
  )

  content = sanitizeContent(content)

  if tier == "Lite" (
    content = "(Lite - gpt-oss-120b)\n" ++ content
  )

  if content.len > 2000 (
    content = content.trim(0, 1997) ++ "..."
  )

  editMessage(c, reply_msg, content)
)
