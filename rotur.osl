// Rotur API helpers

def fetchUserData(username) object (
  object resp = requests.Get("https://api.rotur.dev/admin/get_user_by?key=username&value=" ++ username.toStr(), ADMIN_HEADERS)
  if !resp.success (
    return { error: "Failed to fetch user data." }
  )
  any parsed = resp.body.toStr().JsonParse()
  if typeof(parsed) != "object" (
    return { error: "Failed to fetch user data." }
  )
  object user = parsed.assert(object)
  if user.error != null (
    return { error: user.error.toStr() }
  )
  // update cache
  string token = (user.key ?? "").toStr()
  if token != "" (
    token_cache[username.toStr()] = token
  )
  return user
)

def getUserData(username) object (
  return fetchUserData(username)
)

// Returns the auth token for a user, using the cache.
// Returns "" if the token cannot be obtained.
def getToken(username) string (
  string uname = username.toStr()

  // return cached token if we have one
  if token_cache.contains(uname) (
    return token_cache[uname].toStr()
  )

  // cache miss — fetch from API
  object user = fetchUserData(uname)
  if user.error != null (
    return ""
  )
  return (token_cache[uname] ?? "").toStr()
)

// Invalidates cached token and refetches. Returns new token or "".
def invalidateToken(username) string (
  string uname = username.toStr()
  token_cache.delete(uname)
  object user = fetchUserData(uname)
  if user.error != null (
    return ""
  )
  return (token_cache[uname] ?? "").toStr()
)

def getUserFileSize(token) number (
  object resp = requests.Get("https://api.rotur.dev/files/usage?auth=" ++ token.toStr())
  if !resp.success (
    return 0
  )
  any parsed = resp.body.toStr().JsonParse()
  if typeof(parsed) != "object" (
    return 0
  )
  object data = parsed.assert(object)
  return (data.used_size ?? 0).toNum()
)

def getPostsByUser(username) object (
  object resp = requests.Get("https://api.rotur.dev/profile?username=" ++ username.toStr() ++ "&include_posts=1")
  if !resp.success (
