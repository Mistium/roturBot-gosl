def users_patch(auth, key, value) object (
  object resp = requests.Patch("https://api.rotur.dev/users", {
    "content-type": "application/json",
    "body": { "auth": auth, "key": key, "value": value }
  })
  if !resp.success (
    return { error: "Request failed" }
  )
  any parsed = resp.body.toStr().JsonParse()
  if typeof(parsed) != "object" (
    return { error: "Invalid response" }
  )
  return parsed.assert(object)
)

def users_delete(auth, key) object (
  object resp = requests.Delete("https://api.rotur.dev/users", {
    "content-type": "application/json",
    "body": { "auth": auth, "key": key }
  })
  if !resp.success (
    return { error: "Request failed" }
  )
  string body_str = resp.body.toStr()
  if body_str == "" (
    return { success: true }
  )
  any parsed = body_str.JsonParse()
  if typeof(parsed) != "object" (
    return { success: true }
  )
  return parsed.assert(object)
)

