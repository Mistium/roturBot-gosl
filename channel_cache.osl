def withLock(string lock_name, any func) any (
	lock.Lock(lock_name)
	any result = func()
	lock.Unlock(lock_name)
	return result
)

def withLockArg(string lock_name, any arg, any func) any (
	lock.Lock(lock_name)
	any result = func(arg)
	lock.Unlock(lock_name)
	return result
)

def _cacheKey(string server_id, string channel_id) string (
	return server_id ++ ":" ++ channel_id
)

def cacheAddMessage(string server_id, string channel_id, object msg) (
	lock.Lock(CHANNEL_CACHE_LOCK)
	
	string key = _cacheKey(server_id, channel_id)
	
	if !CHANNEL_MESSAGE_CACHE.contains(key) (
		CHANNEL_MESSAGE_CACHE[key] = []
	)
	
	array messages = CHANNEL_MESSAGE_CACHE[key].assert(array)
	
	object msg_data = {
		id: (msg.id ?? "").toStr(),
		author: (msg.user ?? "unknown").toStr(),
		content: (msg.content ?? "").toStr(),
		timestamp: timestamp
	}
	
	if msg.reply_to != null and typeof(msg.reply_to) == "object" (
		object reply_to = msg.reply_to.assert(object)
		msg_data.reply_to_user = (reply_to.user ?? "unknown").toStr()
		msg_data.reply_to_content = (reply_to.content ?? "").toStr()
	)
	
	if msg.attachments != null and typeof(msg.attachments) == "array" (
		array atts = msg.attachments.assert(array)
		if atts.len > 0 (
			array att_urls = []
			for i atts.len (
				object att = atts[i].assert(object)
				if att.url != null (
					att_urls.append(att.url.toStr())
				)
			)
			if att_urls.len > 0 (
				msg_data.attachments = att_urls
			)
		)
	)
	
	if msg.reactions != null and typeof(msg.reactions) == "object" (
		msg_data.reactions = msg.reactions
	)
	
	messages.append(msg_data)
	
	if messages.len > CHANNEL_CACHE_MAX_SIZE (
		array new_messages = []
		number start = messages.len - CHANNEL_CACHE_MAX_SIZE
		for i CHANNEL_CACHE_MAX_SIZE (
			new_messages.append(messages[start + i])
		)
		CHANNEL_MESSAGE_CACHE[key] = new_messages
	)
	
	lock.Unlock(CHANNEL_CACHE_LOCK)
)

def cacheGetMessages(string server_id, string channel_id, number limit) array (
	lock.Lock(CHANNEL_CACHE_LOCK)
	
	string key = _cacheKey(server_id, channel_id)
	
	if !CHANNEL_MESSAGE_CACHE.contains(key) (
		lock.Unlock(CHANNEL_CACHE_LOCK)
		return []
	)
	
	array messages = CHANNEL_MESSAGE_CACHE[key].assert(array)
	
	if messages.len == 0 (
		lock.Unlock(CHANNEL_CACHE_LOCK)
		return []
	)
	
	number start = 0
	if messages.len > limit (
		start = messages.len - limit
	)
	
	array result = []
	for i messages.len - start (
		result.append(messages[start + i])
	)
	
	lock.Unlock(CHANNEL_CACHE_LOCK)
	return result
)

def cacheGetHistoryString(string server_id, string channel_id, number limit) string (
	lock.Lock(CHANNEL_CACHE_LOCK)
	
	string key = _cacheKey(server_id, channel_id)
	
	if !CHANNEL_MESSAGE_CACHE.contains(key) (
		lock.Unlock(CHANNEL_CACHE_LOCK)
		return ""
	)
	
	array messages = CHANNEL_MESSAGE_CACHE[key].assert(array)
	
	if messages.len == 0 (
		lock.Unlock(CHANNEL_CACHE_LOCK)
		return ""
	)
	
	number start = 0
	if messages.len > limit (
		start = messages.len - limit
	)
	
	array history_lines = []
	
	for i messages.len - start (
		object msg = messages[start + i].assert(object)
		
		string line = (msg.author ?? "unknown").toStr() ++ " said \"" ++ (msg.content ?? "").toStr() ++ "\""
		
		if msg.reply_to_user != null (
			line ++= " (in reply to " ++ msg.reply_to_user.toStr()
			if msg.reply_to_content != null and msg.reply_to_content.toStr().len > 0 (
				line ++= " saying \"" ++ msg.reply_to_content.toStr() ++ "\""
			)
			line ++= ")"
		)
		
		if msg.attachments != null and typeof(msg.attachments) == "array" (
			array atts = msg.attachments.assert(array)
			if atts.len > 0 (
				line ++= " (with attachments: " ++ atts.join(", ") ++ ")"
			)
		)
		
		if msg.reactions != null and typeof(msg.reactions) == "object" (
			line ++= " (with reactions: " ++ msg.reactions.toStr() ++ ")"
		)
		
		line ++= " (message_id: " ++ (msg.id ?? "").toStr() ++ ")"
		
		history_lines.append(line)
	)
	
	lock.Unlock(CHANNEL_CACHE_LOCK)
	return history_lines.join("\n")
)

def cacheClearChannel(string server_id, string channel_id) (
	lock.Lock(CHANNEL_CACHE_LOCK)
	string key = _cacheKey(server_id, channel_id)
	if CHANNEL_MESSAGE_CACHE.contains(key) (
		CHANNEL_MESSAGE_CACHE.delete(key)
	)
	lock.Unlock(CHANNEL_CACHE_LOCK)
)

def cacheClearServer(string server_id) (
	lock.Lock(CHANNEL_CACHE_LOCK)
	array keys_to_delete = []
	array keys = CHANNEL_MESSAGE_CACHE.getKeys()
	for i keys.len (
		string k = keys[i].toStr()
		if k.startsWith(server_id ++ ":") (
			keys_to_delete.append(k)
		)
	)
	for i keys_to_delete.len (
		CHANNEL_MESSAGE_CACHE.delete(keys_to_delete[i].toStr())
	)
	lock.Unlock(CHANNEL_CACHE_LOCK)
)

def cacheClearAll() (
	lock.Lock(CHANNEL_CACHE_LOCK)
	CHANNEL_MESSAGE_CACHE = {}
	lock.Unlock(CHANNEL_CACHE_LOCK)
)

def cacheGetMessageById(string server_id, string channel_id, string message_id) object (
	lock.Lock(CHANNEL_CACHE_LOCK)
	
	string key = _cacheKey(server_id, channel_id)
	
	if !CHANNEL_MESSAGE_CACHE.contains(key) (
		lock.Unlock(CHANNEL_CACHE_LOCK)
		return null
	)
	
	array messages = CHANNEL_MESSAGE_CACHE[key].assert(array)
	
	for i messages.len (
		object msg = messages[i].assert(object)
		if (msg.id ?? "").toStr() == message_id (
			lock.Unlock(CHANNEL_CACHE_LOCK)
			return msg
		)
	)
	
	lock.Unlock(CHANNEL_CACHE_LOCK)
	return null
)
