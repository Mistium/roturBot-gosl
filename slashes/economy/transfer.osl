def transfer(*Connection c, object msg) (
  string username = ""
  number amount = 0
  string note = ""

  // Prefer structured args from slash_call, fall back to text parsing
  any msg_args = msg.args
  if typeof(msg_args) == "object" (
    object args = msg_args.assert(object)
    if args.getKeys().len > 0 (
      username = (args.username ?? "").toStr()
      amount = (args.amount ?? 0).toNum()
      note = (args.note ?? "").toStr()
    ) else (
      array parts = msg.content.toStr().split(" ")
      if parts.len < 2 (
        sendResponse(c, msg, "Usage: /transfer <username> <amount>")
        return
      )
      username = parts[1].toStr()
      amount = parts[2].toNum()
      note = parts.trim(3, -1).join(" ")
    )
  ) else (
    array parts = msg.content.toStr().split(" ")
    if parts.len < 2 (
      sendResponse(c, msg, "Usage: /transfer <username> <amount>")
      return
    )
    username = parts[1].toStr()
    amount = parts[2].toNum()
    note = parts.trim(3, -1).join(" ")
  )

  if username == "" (
    sendResponse(c, msg, "Usage: /transfer <username> <amount>")
    return
  )

  if amount < 0.01 (
    sendResponse(c, msg, "Amount must be at least 0.01")
    return
  )

  string url = "https://api.rotur.dev/admin/transfer_credits?to=" ++ username ++ "&amount=" ++ amount.toStr() ++ "&from=" ++ msg.user ++ "&note=" ++ encodeURIComponent(note)
  object resp = requests.Post(url, ADMIN_HEADERS)

  any body = resp.body.toStr().JsonParse()

  if typeof(body) != "object" (
    sendResponse(c, msg, "Error: " ++ body.toStr())
    return
  )

  object parsed = body.assert(object)

  if parsed.error != null (
    sendResponse(c, msg, parsed.error.toStr())
    return
  )

  sendResponse(c, msg, "Transferred " ++ amount.toStr() ++ " credits to " ++ username)
)