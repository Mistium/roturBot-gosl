def friends_list(*Connection c, object msg) (
  string token = getToken(msg.user)
  if token == "" (
    sendResponse(c, msg, "Could not retrieve your auth token.")
    return
  )

  object resp = friendsList(token)

  if resp.error != null (
    sendResponse(c, msg, resp.error.toStr())
    return
  )

  any friends = resp.friends
  if friends == null (
    sendResponse(c, msg, "You don't have any friends yet.")
    return
  )

  if typeof(friends) != "array" (
    sendResponse(c, msg, "You don't have any friends yet.")
    return
  )

  array arr = friends.assert(array)
  if arr.len == 0 (
    sendResponse(c, msg, "You don't have any friends yet.")
    return
  )

  sendResponse(c, msg, "Your friends:\n" ++ arr.join("\n"))
)
