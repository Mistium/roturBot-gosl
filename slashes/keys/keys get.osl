def keys_get(*Connection c, object msg) (
  string keyname = ""

  any msg_args = msg.args
  if typeof(msg_args) == "object" (
    object args = msg_args.assert(object)
    if args.contains("keyname") (
      keyname = args.keyname.toStr()
    )
  )

  if keyname == "" (
    array parts = msg.content.toStr().split(" ")
    if parts.len < 1 or parts[1].toStr() == "" (
      sendResponse(c, msg, "Usage: /keys get <keyname>")
      return
    )
    keyname = parts.join(" ")
  )

  object data = getUserData(msg.user)

  if data.error != null (
    sendResponse(c, msg, data.error.toStr())
    return
  )

  if keyname == "key" (
    sendResponse(c, msg, "You cannot get your own key")
    return
  )

  if !data.contains(keyname) (
    sendResponse(c, msg, "Key not found")
    return
  )

  any value = data[keyname]

  sendResponse(c, msg, value.toStr())
)