def keys_set(*Connection c, object msg) (
  string keyname = ""
  string value = ""

  any msg_args = msg.args
  if typeof(msg_args) == "object" (
    object args = msg_args.assert(object)
    if args.contains("keyname") (
      keyname = args.keyname.toStr()
    )
    if args.contains("value") (
      value = args.value.toStr()
    )
  )

  if keyname == "" (
    array parts = msg.content.toStr().split(" ")
    if parts.len < 2 (
      sendResponse(c, msg, "Usage: /keys set <keyname> <value>")
      return
    )
    keyname = parts[1].toStr()
    value = parts.trim(2, -1).join(" ")
  )

  if keyname == "" (
    sendResponse(c, msg, "Usage: /keys set <keyname> <value>")
    return
  )

  object data = getUserData(msg.user)

  if data.error != null (
    sendResponse(c, msg, data.error.toStr())
    return
  )

  if !data.contains("keys") (
    data.keys = {}
  )

  data.keys[keyname] = value

  object resp = users_patch(data.key, keyname, value)

  if resp.error != null (
    sendResponse(c, msg, resp.error.toStr())
    return
  )

  sendResponse(c, msg, "Key " ++ keyname ++ " set to " ++ value)
)