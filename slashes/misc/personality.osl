def personality(*Connection c, object msg) (
  string action = msg.args.action.toStr()
  
  if action == "set" (
    string name = msg.args.name.toStr()
    string personality_content = getPersonalityPrompt(name)
    if personality_content.len > 0 (
      object result = setUserPersonality(msg.user.toStr(), name)
      if result.success == true (
        sendResponse(c, msg, "Personality set to: " ++ name)
      ) else (
        sendResponse(c, msg, "Failed to set personality: " ++ (result.error ?? "unknown"))
      )
    ) else (
      sendResponse(c, msg, "Personality not found: " ++ name)
    )
    return
  )
  
  if action == "get" (
    string current = getUserPersonality(msg.user.toStr())
    sendResponse(c, msg, "Your current personality: " ++ current)
    return
  )
  
  if action == "list" (
    array personality_list = listPersonalities()
    sendResponse(c, msg, "Available personalities:\n" ++ personality_list.join("\n"))
    return
  )
  
  sendResponse(c, msg, "Usage: /personality [set|get|list]")
)
